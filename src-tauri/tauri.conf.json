{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FlickVert",
  "version": "0.1.0",
  "identifier": "app.flickvert.desktop",
  "build": {
    "beforeDevCommand": null,
    "devUrl": null,
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "FlickVert",
      "create": false,
      "width": 1120,
      "height": 760,
      "minWidth": 760,
      "minHeight": 600,
      "resizable": true,
      "center": true
    }],
    "security": {
      "csp": "default-src 'self' asset: http://asset.localhost; img-src 'self' asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Local file converter",
    "macOS": { "minimumSystemVersion": "13.0" }
  }
}
