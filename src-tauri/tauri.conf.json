{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FlickVert",
  "version": "0.1.18",
  "identifier": "app.flickvert.desktop.v2",
  "build": {
    "beforeDevCommand": null,
    "devUrl": null,
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FlickVert",
        "create": false,
        "width": 900,
        "height": 720,
        "minWidth": 640,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self' asset: http://asset.localhost; img-src 'self' asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM5MkQzNTA2ODkyQzc2QkMKUldTOGRpeUpCalV0T1VHS0lJYUdxT3FsWUJYT2JEdUR0VDJNTlJPN2k5akZ4UVlQTUdSR3hndVEK",
      "requireSignedVersion": true,
      "endpoints": [
        "https://github.com/PavelCRG/FlickVert/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "resources/THIRD_PARTY_NOTICES.md"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Local file converter",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "Russian",
          "SimpChinese"
        ],
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp"
      }
    },
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
